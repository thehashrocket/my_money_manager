# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# design artifacts + real bank-data samples (simplefin:sample writes here)
/.context/

# local sqlite db + pre-import snapshots
/data/*.db
/data/*.db-journal
/data/*.db-wal
/data/*.db-shm
/data/money.db.pre-import-*
/data/money.db.pre-migrate-*
/data/.pending-imports/

# typescript
*.tsbuildinfo
next-env.d.ts

# gbrain worktree-scoped source pin (per-machine, set by /sync-gbrain)
.gbrain-source

# gstack local daemon state (per-machine PID/port lockfiles, not project source)
/.gstack/

# Docker-image-only build artifacts: esbuild-bundled from docker/entrypoint.src.mjs
# and scripts/snapshot-cli.src.mjs by scripts/build-docker-artifacts.mjs, which the
# builder stage runs. The runner has no src/ tree, so these can't stay thin wrappers
# that import it — see docs/plans/dockerize-postgres.md.
/docker/entrypoint.mjs
/scripts/snapshot-cli.mjs

# db:export destination + host bind mount for container snapshots (D3.3B)
/backups/
